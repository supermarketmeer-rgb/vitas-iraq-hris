{
  "name": "vitas-iraq-hrms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js --port=5173 --host=0.0.0.0\"",
    "build": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-desktop",
    "lint": "tsc --noEmit",
    "server": "node server.js",
    "dev:full": "concurrently \"node server.js\" \"npm run dev\"",
    "electron:dev": "concurrently \"npm run dev:full\" \"npx electron .\"",
    "build:desktop": "npm run build && npx electron-builder"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mssql": "^12.7.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.vitasiraq.hrms.desktop",
    "productName": "VITAS Iraq HRMS",
    "executableName": "VITASIraqHRMS",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "database/**/*",
      "server.js",
      "package.json",
      "!node_modules/@esbuild/**/*",
      "!node_modules/vite/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/lightningcss*/**/*",
      "!node_modules/@tailwindcss/**/*",
      "!node_modules/tailwindcss/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VITAS Iraq HRMS"
    }
  }
}
